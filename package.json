    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@ionic/angular": "9.0.8",
    "ionicons": "8.1.0",
    "maplibre-gl": "6.15.0",
    "rxjs": "7.8.2",
